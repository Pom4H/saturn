{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@scada/plant": [
        "./plant/dsl.ts"
      ],
      "@scada/hmi": [
        "./src/hmi.ts"
      ]
    }
  },
  "include": [
    "plant/**/*.ts"
  ]
}
