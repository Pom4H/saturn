{
  "name": "@saturn/scada",
  "version": "0.1.0",
  "description": "Saturn engineering IDE, SCADA runtime and TypeScript project DSL.",
  "scripts": {
    "site:build": "node scripts/site-build.mjs",
    "site:dev": "node scripts/site-dev.mjs",
    "site:check": "tsc --noEmit -p tsconfig.site.json && node scripts/site-check.mjs",
    "build": "node scripts/build.mjs && node scripts/plant-build.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lab.json",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run typecheck && npm test && npm run challenge:core && npm run lab:test && npm run lab:build && npm run plant:typecheck && npm run plant:test && npm run test:consumer && npm run vscode:check",
    "challenge": "node scripts/challenge.mjs",
    "challenge:core": "node scripts/challenge.mjs core",
    "challenge:browser": "node scripts/challenge.mjs browser",
    "challenge:bench": "node scripts/challenge.mjs bench",
    "lab:build": "node scripts/lab-build.mjs",
    "lab": "node scripts/lab-build.mjs --serve",
    "lab:test": "node scripts/lab-test.mjs",
    "lab:capture": "node scripts/lab-capture.mjs",
    "test:consumer": "node scripts/consumer-test.mjs",
    "plant:build": "node scripts/plant-build.mjs",
    "plant": "npm run plant:build && node --experimental-sqlite .plant/server.mjs",
    "plant:typecheck": "tsc --noEmit -p tsconfig.plant.json",
    "plant:test": "node scripts/plant-test.mjs",
    "plant:test:browser": "node scripts/plant-e2e.mjs",
    "plant:check": "npm run plant:build && npm run plant:typecheck && npm run plant:test",
    "site:test:browser": "node scripts/site-studio-check.mjs",
    "saturn": "node scripts/saturn.mjs",
    "standalone:pack": "bun run scripts/standalone-pack.ts",
    "update:manifest": "node scripts/sign-update-manifest.mjs",
    "vscode:test": "node --test vscode/test/*.test.cjs",
    "vscode:check": "npm run vscode:build && node scripts/vscode-check.mjs && npm run vscode:test",
    "vscode:build": "node scripts/vscode-build.mjs",
    "authoring:typecheck": "tsc --noEmit -p tsconfig.authoring.json",
    "authoring:test": "node scripts/authoring-check.mjs"
  },
  "keywords": [],
  "author": "Roman Popov",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@typescript/typescript6": "6.0.2",
    "codemirror": "6.0.2",
    "three": "0.185.1",
    "web-push": "3.6.7"
  },
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pom4H/saturn.git"
  },
  "engines": {
    "node": ">=22.16.0 <23 || >=24.20.0 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/three": "0.185.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "bin": {
    "saturn": "scripts/saturn.mjs"
  }
}
